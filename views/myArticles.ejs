<%- include('partials/head', { title: 'My Articles' }) %>

<main class="page">
  <header class="page-header">
    <div>
      <p class="eyebrow">Dashboard</p>
      <h1>My Articles</h1>
      <p class="page-description">You have published <%= articles.length %> article<%= articles.length === 1 ? '' : 's' %>.</p>
    </div>

    <div class="page-actions">
      <a class="button" href="/articles/new">New Article</a>
    </div>
  </header>

  <% if (articles.length === 0) { %>
    <section class="empty-state">
      <h2>No articles yet</h2>
      <p>Your published articles will appear here.</p>
      <a class="button" href="/articles/new">Write your first article</a>
    </section>
  <% } else { %>
    <section class="article-list">
      <% articles.forEach(article => { %>
        <article class="article-card">
          <p class="article-meta">
            Published
            <span class="meta-divider">&middot;</span>
            <time datetime="<%= article.createdAt.toISOString() %>"><%= article.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></time>
          </p>

          <h2><a href="/articles/<%= article._id %>"><%= article.title %></a></h2>
          <p class="article-excerpt"><%= article.content.length > 180 ? article.content.slice(0, 180).trim() + '...' : article.content %></p>

          <div class="card-actions">
            <a class="button button-secondary button-small" href="/articles/<%= article._id %>">View</a>
            <a class="button button-secondary button-small" href="/articles/<%= article._id %>/edit">Edit</a>
            <form action="/articles/<%= article._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this article?');" style="display:inline;">
              <button class="button button-danger button-small" type="submit">Delete</button>
            </form>
          </div>
        </article>
      <% }) %>
    </section>
  <% } %>
</main>

<%- include('partials/footer') %>
